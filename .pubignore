# Build artifacts
build/
coverage/
*.log

# Large README media use absolute raw.githubusercontent.com URLs. The new
# SVG mark lives at the package root so pub.dev can render the README too.
assets/

# Website MDX docs — these are for the nib website, not the pub package
doc/

# Showcase apps — large standalone demos, browsable on GitHub but not needed on pub.dev
showcase/

# Generated example platform projects are local and not tracked for release.
example/android/
example/linux/
example/web/

# IDE
*.iml
.idea/

# Claude Code
.claude/
CLAUDE.md
