# Build artifacts
build/
coverage/
*.log

# README media (logo, banner, GIFs). The README references these via absolute
# raw.githubusercontent.com URLs, so they ship on GitHub (kept in git) and don't
# need to bloat the published pub package.
assets/

# Website MDX docs — these are for the nib website, not the pub package
doc/

# Showcase apps — large standalone demos, browsable on GitHub but not needed on pub.dev
showcase/

# Generated example platform projects are local and not tracked for release.
example/android/
example/linux/
example/web/

# IDE
*.iml
.idea/

# Claude Code
.claude/
CLAUDE.md
