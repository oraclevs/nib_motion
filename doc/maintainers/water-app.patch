@@ -0,0 +1,78 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:integration_test/integration_test.dart';
+import 'package:motion_nib_0_3/main.dart';
+import 'package:nib_motion/nib_motion.dart';
+
+void main() {
+  final binding = IntegrationTestWidgetsFlutterBinding.ensureInitialized();
+  binding.framePolicy = LiveTestWidgetsFlutterBindingFramePolicy.fullyLive;
+  testWidgets('record portrait water interactions at real speed', (
+    tester,
+  ) async {
+    final paths = <String, NibWaterRenderPath>{};
+    await tester.pumpWidget(
+      App(
+        onWaterStatus: (surface, status) {
+          if (paths[surface] == status.path) return;
+          paths[surface] = status.path;
+          debugPrint(
+            'WATER_RENDER ${jsonEncode({'surface': surface, 'path': status.path.name, 'backend': status.backend, 'message': status.message})}',
+          );
+        },
+      ),
+    );
+    await tester.pump(const Duration(seconds: 5));
+    final rect = tester.getRect(find.byKey(const ValueKey('shore-water')));
+    expect(rect.height, greaterThan(rect.width));
+    expect(paths['shore'], NibWaterRenderPath.refractive);
+    debugPrint('WATER_READY ${rect.size}');
+    const marker = String.fromEnvironment('CAPTURE_START');
+    expect(marker, isNotEmpty, reason: 'Pass an absolute start-marker path.');
+    final timeout = Stopwatch()..start();
+    while (!File(marker).existsSync()) {
+      expect(timeout.elapsed.inMinutes, lessThan(10));
+      await tester.pump(const Duration(milliseconds: 200));
+    }
+    final clock = Stopwatch()..start();
+    void scene(String name) =>
+        debugPrint('WATER_SCENE $name ${clock.elapsedMilliseconds}');
+    Offset point(double x, double y) =>
+        rect.topLeft + Offset(rect.width * x, rect.height * y);
+    scene('opening');
+    await tester.pump(const Duration(seconds: 2));
+    scene('first-wave');
+    await tester.tapAt(point(.32, .32));
+    await tester.pump(const Duration(seconds: 3));
+    scene('second-wave');
+    await tester.tapAt(point(.70, .43));
+    await tester.pump(const Duration(seconds: 3));
+    scene('swipe');
+    await tester.timedDragFrom(
+      point(.26, .38),
+      Offset(rect.width * .46, 35),
+      const Duration(milliseconds: 1100),
+    );
+    await tester.pump(const Duration(seconds: 3));
+    scene('dive');
+    await tester.tap(find.byKey(const ValueKey('dive')));
+    await tester.pump(const Duration(seconds: 3));
+    expect(paths['ocean'], NibWaterRenderPath.refractive);
+    scene('pearl');
+    await tester.tap(find.bySemanticsLabel('Collect pearl 3'));
+    await tester.pump(const Duration(seconds: 3));
+    scene('return');
+    await tester.tap(find.byKey(const ValueKey('back')));
+    await tester.pump(const Duration(seconds: 4));
+    scene('closing');
+    expect(tester.takeException(), isNull);
+    // Leave a clean closing hold while the recorder is stopped.
+    await tester.pump(const Duration(seconds: 12));
+    await tester.pumpWidget(const SizedBox());
+    await tester.pump(const Duration(seconds: 2));
+    expect(tester.takeException(), isNull);
+  });
+}
